#!/usr/bin/env zsh
# Build and install rsdk from source for zsh. Mirrors what the release
# installer does for zsh (scripts/install.sh `configure_posix zsh`), but
# uses the local build + templates instead of downloading a release archive.
#
# Usage: ./dev/install-zsh [--debug]

set -eu

cd "${0:A:h}/.."

RSDK_HOME="${RSDK_HOME:-$HOME/.rsdk}"

if [[ "${1:-}" == "--debug" ]]; then
    cargo build
    rsdk_exe="target/debug/rsdk"
else
    cargo build --release
    rsdk_exe="target/release/rsdk"
fi

mkdir -p "$RSDK_HOME/bin" "$RSDK_HOME/shell/zsh"
cp -f "$rsdk_exe" "$RSDK_HOME/bin/rsdk"
chmod +x "$RSDK_HOME/bin/rsdk"
cp -f templates/zsh/rsdk.zsh "$RSDK_HOME/shell/zsh/rsdk.zsh"

rc_file="$HOME/.zshrc"
loader="$RSDK_HOME/shell/zsh/rsdk.zsh"
touch "$rc_file"
if grep -Fq '# >>> rsdk initialize >>>' "$rc_file"; then
    printf '✓ rsdk initialization already present in %s; not modified.\n' "$rc_file"
else
    cat >> "$rc_file" <<EOF

# >>> rsdk initialize >>>
source "$loader"
# <<< rsdk initialize <<<
EOF
    printf '✓ Configured zsh via %s.\n' "$rc_file"
fi

comp_file="$HOME/.zsh/completions/_rsdk"
mkdir -p "$(dirname "$comp_file")"
if "$RSDK_HOME/bin/rsdk" completions zsh > "$comp_file" 2>/dev/null; then
    printf '✓ Installed zsh completions: %s\n' "$comp_file"
else
    printf '⚠ Could not generate zsh completions\n' >&2
fi
# zsh only loads the file when its directory is on fpath before compinit.
if ! grep -Eq 'fpath=.*\.zsh/completions|\.zsh/completions.*fpath' "$rc_file" 2>/dev/null; then
    printf '→ Add ~/.zsh/completions to fpath before compinit to load zsh completions.\n'
fi

printf '\nActivate in the current session: source "%s"\n' "$loader"
