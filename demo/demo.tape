# rsdk TUI demo — deterministic, generated by `just demo` against
# demo/mock_api.py (a fixed SDKMAN catalog) and a throwaway install home.
Output docs/demo.gif

Set Shell "bash"
Set FontFamily "Noto Sans Mono"
Set FontSize 16
Set Width 1440
Set Height 820
Set PlaybackSpeed 1

Hide
Type "rsdk tui"
Enter
Sleep 2s
Show

Sleep 2s

# Browse the tools list, then return to java (the starred/installed one).
Down
Sleep 600ms
Down
Sleep 600ms
Up
Sleep 600ms
Up
Sleep 600ms

# Drill into java's versions (the versions pane becomes active).
Enter
Sleep 1s

# Open the action modal on the selected version: installed -> 3 actions.
Enter
Sleep 2s
Escape
Sleep 600ms

# Move to an uninstalled version and open its Install-only modal.
Down
Sleep 400ms
Down
Sleep 400ms
Enter
Sleep 2s
Escape
Sleep 600ms

# Back out to the tools list, then quit.
Escape
Sleep 600ms
Ctrl+q
Sleep 500ms
